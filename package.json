{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0",
		"autoprefixer": "^10.4.21",
		"cpy-cli": "^5.0.0",
		"cssnano": "^7.0.6",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.3",
		"postcss-cli": "^11.0.1",
		"rimraf": "^6.0.1",
		"sass": "^1.86.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "npm run build",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli",
		"wp": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-share-buttons\" wp",
		"composer": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-share-buttons\" composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run cli --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-share-buttons\" composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:lint": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-share-buttons\" composer run-script lint",
		"posttest:php:lint": "npm run test:php:stop",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:unit": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-share-buttons\" vendor/bin/phpunit -- -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "npm run test:php:stop",
		"test:lint:php": "npm run test:php:lint || (test_status=$?; npm run test:php:stop; exit $test_status)",
		"test:lint": "npm run test:lint:php",
		"test:unit:js": "node --test tests/js/*.test.cjs",
		"test:unit:php": "npm run test:php:unit || (test_status=$?; npm run test:php:stop; exit $test_status)",
		"test:unit": "run-s test:unit:js test:unit:php",
		"test": "run-s test:lint test:unit",
		"cleanup:css": "rimraf src/assets/css",
		"cleanup:js": "rimraf src/assets/js",
		"cleanup:img": "rimraf src/assets/img",
		"css:app": "sass --no-source-map src/src/css:src/assets/css && postcss src/assets/css/*.css -r",
		"css": "npm run cleanup:css && npm-run-all -p css:*",
		"js:build": "wp-scripts build src/src/js/wp-share-buttons.js --output-path src/assets/js",
		"js": "npm-run-all -s cleanup:js js:build",
		"img": "npm run cleanup:img && cpy 'src/src/img/*' 'src/assets/img'",
		"build": "npm-run-all -p css js img",
		"make-pot": "npm run wp i18n -- make-pot ./src ./src/languages/generic.pot --domain=inc2734-wp-share-buttons"
	}
}
